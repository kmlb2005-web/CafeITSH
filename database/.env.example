# =====================================================================
# Plantilla de variables de entorno para database/.env
#
# Cómo usarla:
#   1. Copia este archivo y renómbralo a ".env" (misma carpeta database/).
#   2. Rellena los valores reales.
#   3. El archivo .env real NUNCA se sube a Git (excluido en .gitignore).
#
# Verifica que las variables coincidan con las de tu .env real.
# =====================================================================

# --- Servicio MySQL (lo consume docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=pon-aqui-la-contrasena-root
MYSQL_DATABASE=cafeitsh_db
MYSQL_USER=cafe_admin
MYSQL_PASSWORD=pon-aqui-la-contrasena-de-cafe_admin

# --- Backend (Spring Boot) ---
# Estas variables se definen en la shell antes de correr Maven
# (no se leen desde este archivo). Requisitos de docs/AGENTS.md:
#
#   DB_PASSWORD    = mismo valor que MYSQL_PASSWORD (obligatoria;
#                    sin ella todos los tests fallan)
#   JWT_SECRET     = secreto de firma JWT, mínimo 32 caracteres
#                    (obligatoria para la app y para mvnw.cmd test)
#   ADMIN_CORREO   = opcional, correo del primer ADMIN
#   ADMIN_PASSWORD = opcional, contraseña del primer ADMIN
